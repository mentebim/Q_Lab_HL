{
  "experiment_id": "candidate_family_run",
  "candidate_id": "candidate_linear_v1",
  "hypothesis": "One bounded candidate within the approved cross-sectional linear strategy family.",
  "strategy_path": "strategy.py",
  "strategy_family": "linear_cross_section_v1",
  "research_policy_path": "autoresearch/research_policy.json",
  "strategy_spec": {
    "train_window_bars": 504,
    "min_train_rows": 200,
    "position_bucket": 4,
    "target": {
      "name": "fwd_48h_close",
      "kind": "forward_close_return",
      "horizon": 48
    },
    "model": {
      "family": "ridge",
      "l2_reg": 5.0,
      "prediction_clip": 3.0
    },
    "features": [
      {
        "name": "ret_1h",
        "kind": "return",
        "lookback": 1,
        "transform": "zscore",
        "clip": 3.0
      }
    ]
  },
  "execution_overrides": {
    "rebalance_every_bars": 48
  },
  "data_dir": "data/active_1h/machine",
  "synthetic": false,
  "evaluation_periods": [
    "inner",
    "outer",
    "test"
  ],
  "enable_walk_forward": true,
  "notes": "Copy this template for new bounded candidate searches. Target horizon should match rebalance_every_bars.",
  "express_filter": {
    "enabled": true,
    "period": "outer",
    "trailing_bars": 2880,
    "max_assets": 20,
    "bootstrap_samples": 10,
    "primary_metric": "sharpe_annualized",
    "primary_min": -0.5,
    "max_beta_abs": 0.25,
    "max_turnover": 1.0
  },
  "acceptance": {
    "primary_metric": "periods.test.sharpe_annualized",
    "primary_min": 0.3,
    "max_beta_abs": 0.15,
    "max_turnover": 0.75,
    "compare_to_best": false,
    "compare_to_candidate_id": null,
    "min_primary_lift": 0.0
  },
  "recording": {
    "leaderboard_path": "autoresearch/leaderboard.jsonl",
    "results_dir": "autoresearch/results",
    "append_leaderboard": true,
    "write_result": true
  }
}
